# Generated by XcodeGen — never commit
Grove.xcodeproj/

# Generated test workspace — these are git repositories, so they are built by
# scripts/make-fixtures.sh rather than committed. Nesting them here would make
# git treat them as embedded repos and drop their history.
Fixtures/

# Build output
.build/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/

# Leftover from the abandoned Tauri attempt
.vite/
node_modules/

# The diff renderer is built by scripts/web.sh into the app bundle. Its output
# is ~11 MB of generated syntax grammars, so it is built rather than committed.
Web/DiffRenderer/

.DS_Store

# Switches on the opt-in live AI test. See CommitMessageTests.
.grove-test-ai
